{
  "name": "mymeter",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-aware LLM cost meter and local ledger for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite tests/client/visual-demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build": "npm run typecheck && npm run build:plugin",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm test && npm run build && npm run verify:package",
    "pack:plugin": "npm pack --workspace @mymeter/dsh-cost-meter"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
