{
  "name": "@mymeter/dsh-cost-meter",
  "description": "Provider-aware LLM cost meter and local ledger for DeepSeek Harness",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/plugin/src/cordis-host.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/plugin/src/cordis-host.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/plugin/src/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./host": {
      "types": "./lib/types/plugin/src/cordis-host.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/plugin/src/cordis-client.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/types/plugin/src/typert-remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "node ../../scripts/build-plugin.mjs",
    "prepack": "npm run bundle"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/remote.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
